rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function getMemberRole(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role;
    }

    function isGroupAdmin(groupId) {
      return isGroupMember(groupId) && (getMemberRole(groupId) in ['admin', 'owner']);
    }

    function isGroupOwner(groupId) {
      return isGroupMember(groupId) && getMemberRole(groupId) == 'owner';
    }

    function isGroupHost(groupId) {
      return isGroupMember(groupId) && getMemberRole(groupId) == 'host';
    }

    // A host may claim/renew its server lease, but cannot edit configuration,
    // snapshots, shared files, or release/stop a running server.
    function hostCanStartOrRenewServer(groupId) {
      return isGroupHost(groupId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lease', 'status', 'updatedAt']) &&
        request.resource.data.lease is map &&
        request.resource.data.lease.currentHostId == request.auth.uid &&
        request.resource.data.lease.leaseToken is string &&
        request.resource.data.lease.leaseExpiresAt is number &&
        request.resource.data.lease.leaseExpiresAt > request.time.toMillis() &&
        request.resource.data.lease.leaseExpiresAt <= request.time.toMillis() + 30000 &&
        request.resource.data.lease.epoch is int &&
        request.resource.data.status in ['starting', 'online'] &&
        (resource.data.lease.currentHostId == null || resource.data.lease.currentHostId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isGroupOwner(groupId) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isGroupOwner(groupId);

      match /members/{memberId} {
        // Permite consultar el propio documento incluso cuando aún no existe;
        // la app puede distinguir "no eres miembro" de un permiso denegado.
        allow read: if isGroupMember(groupId) ||
          (isAuthenticated() && memberId == request.auth.uid);
        allow create: if (
          isAuthenticated() && memberId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.role == 'owner' &&
          getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
        ) || (
          isGroupAdmin(groupId) && memberId != request.auth.uid &&
          request.resource.data.userId == memberId &&
          request.resource.data.role in ['admin', 'host', 'player']
        ) || (
          isAuthenticated() && memberId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.role == 'player' &&
          request.resource.data.inviteId is string &&
          exists(/databases/$(database)/documents/groups/$(groupId)/invites/$(request.resource.data.inviteId)) &&
          request.resource.data.addedBy == get(/databases/$(database)/documents/groups/$(groupId)/invites/$(request.resource.data.inviteId)).data.createdBy &&
          getAfter(/databases/$(database)/documents/groups/$(groupId)/invites/$(request.resource.data.inviteId)).data.usedCount ==
            get(/databases/$(database)/documents/groups/$(groupId)/invites/$(request.resource.data.inviteId)).data.usedCount + 1
        );
        allow update: if isGroupOwner(groupId) && memberId != request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.role in ['admin', 'host', 'player'];
        allow delete: if isGroupOwner(groupId) && memberId != request.auth.uid;
      }

      match /shared_files/{fileId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId) && !isGroupHost(groupId) &&
          request.resource.data.uploadedBy == request.auth.uid &&
          request.resource.data.sizeBytes >= 0 &&
          request.resource.data.chunkCount > 0 &&
          request.resource.data.chunkCount <= 1000000 &&
          request.resource.data.chunkSize == 8 * 1024 * 1024;
        allow delete: if isGroupMember(groupId) && !isGroupHost(groupId) &&
          (isGroupAdmin(groupId) || resource.data.uploadedBy == request.auth.uid);
      }

      match /invites/{inviteId} {
        allow read: if isAuthenticated();
        allow create, delete: if isGroupAdmin(groupId);
        allow update: if isGroupAdmin(groupId) || (
          isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
          request.resource.data.usedCount == resource.data.usedCount + 1 &&
          request.resource.data.usedCount <= resource.data.maxUses &&
          request.time.toMillis() < resource.data.expiresAt &&
          getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.inviteId == inviteId
        );
      }

      match /servers/{serverId} {
        allow read: if isGroupMember(groupId);
        allow create, delete: if isGroupAdmin(groupId);
        
        // Admin/owner control server configuration. Hosts can only claim/renew a lease to start it.
        allow update: if isGroupAdmin(groupId) || hostCanStartOrRenewServer(groupId);

        match /snapshots/{snapshotId} {
          allow read: if isGroupMember(groupId);
          allow create: if isGroupAdmin(groupId);
          allow update, delete: if isGroupAdmin(groupId);
        }

        match /audit_logs/{logId} {
          allow read: if isGroupAdmin(groupId);
          allow create: if isGroupAdmin(groupId);
          allow update, delete: if false; // Append-only immutable log
        }
      }
    }
  }
}
